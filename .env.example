# Google Gemini API key (server-only). Jangan commit nilai asli.
GEMINI_API_KEY=

# Opsional: paksa model utama.
# Di Vercel disarankan model cepat agar tidak kena FUNCTION_INVOCATION_TIMEOUT:
# GEMINI_MODEL=gemini-3.5-flash-lite
# Atau: GEMINI_MODEL=gemini-3.6-flash
# Default (tanpa env): 3.6-flash → 3.5-flash-lite (3.8 hanya di lokal)

# Opsional: model generate latar Desain bebas (Gemini image / Nano Banana).
# Imagen (generateImages) sudah di-shutdown — gunakan model image Gemini.
# Default: gemini-3.1-flash-lite-image → gemini-nano-banana-2.1
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Password bersama untuk tim (wajib di Vercel). Bagikan hanya ke anggota tim.
APP_PASSWORD=

# Opsional: secret terpisah untuk tanda tangan cookie (default = APP_PASSWORD)
# APP_AUTH_SECRET=
