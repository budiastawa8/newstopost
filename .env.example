# Google Gemini API key (server-only). Jangan commit nilai asli.
GEMINI_API_KEY=

# Opsional: paksa model utama.
# Di Vercel disarankan model cepat agar tidak kena FUNCTION_INVOCATION_TIMEOUT:
# GEMINI_MODEL=gemini-3.5-flash-lite
# Atau: GEMINI_MODEL=gemini-3.6-flash
# Default (tanpa env): 3.6-flash → 3.5-flash-lite (3.8 hanya di lokal)

# Cloudflare Workers AI — generate latar Desain bebas (gratis, ~neurons/hari).
# Dashboard → Workers AI → Use REST API → Account ID + Create a Workers AI API Token
# PENTING: isi HANYA nilai mentah, JANGAN tempel perintah curl verify.
# Contoh benar:
#   CLOUDFLARE_ACCOUNT_ID=a1b2c3d4e5f6...
#   CLOUDFLARE_API_TOKEN=cfut_xxxxxxxx
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Opsional: paksa model (default: SDXL Lightning → SDXL → Dreamshaper → FLUX)
# CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning

# Password bersama untuk tim (wajib di Vercel). Bagikan hanya ke anggota tim.
APP_PASSWORD=

# Opsional: secret terpisah untuk tanda tangan cookie (default = APP_PASSWORD)
# APP_AUTH_SECRET=
