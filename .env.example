# Google Gemini API key (server-only). Jangan commit nilai asli.
GEMINI_API_KEY=

# Opsional: paksa model utama.
# Di Vercel disarankan model cepat agar tidak kena FUNCTION_INVOCATION_TIMEOUT:
# GEMINI_MODEL=gemini-3.5-flash-lite
# Atau: GEMINI_MODEL=gemini-3.6-flash
# Default (tanpa env): 3.6-flash → 3.5-flash-lite (3.8 hanya di lokal)
